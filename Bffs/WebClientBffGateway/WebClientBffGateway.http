@WebClientBffGateway_HostAddress = http://localhost:7810


### ADD NEW PATIENT ###
POST {{WebClientBffGateway_HostAddress}}/patient
Accept: application/json
Content-Type: application/json

{
  "firstName": "Naama",
  "lastName": "Dahan",
  "dateOfBirth": "2015-01-08",
  "gender": "Male",
  "address": "Jerusalem"
}

### GET ALL PATIENTS ###
GET {{WebClientBffGateway_HostAddress}}/patient
Accept: application/json
Content-Type: application/json

### SET CURRENT VITAL ###
POST {{WebClientBffGateway_HostAddress}}/vitals/current
Accept: application/json
Content-Type: application/json

{
  "patientId":2 ,
  "vitalsData": {
    "temperature": 36.7,
    "bloodPressure": {
      "systolic": 110,
      "diastolic": 30
    },
    "heartRate": 50,
    "respiratoryRate": 16,
    "oxygenSaturation": 98
  }
}

### GET PATEIENT HISTORY###

GET {{WebClientBffGateway_HostAddress}}/history/1
Accept: application/json
Content-Type: application/json
####

POST {{WebClientBffGateway_HostAddress}}/chat
Accept: application/json
Content-Type: application/json

{
  "Question": "What is the last Blood pressure of patient 1? "
}
