{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Trace"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "vitals-current-add": {
        "ClusterId": "patientMonitoringServiceCluster",
        "Match": {
          "Path": "/vitals/current"
        },
        "Transforms": [
          {
            "PathPattern": "/vitals"
          }
        ]

      },
      "vitals-current": {
        "ClusterId": "patientMonitoringServiceCluster",
        "Match": {
          "Path": "/vitals/current/{patientId}"
        },
        "Transforms": [
          {
            "PathPattern": "/vitals/{patientId}"
          }
        ]

      },
      "vitals-rest": {
        "ClusterId": "patientMonitoringServiceCluster",
        "Match": {
          "Path": "/vitals/{**catchAll}"
        },
        "Transforms": [
          {
            "PathPattern": "/vitals/{**catchAll}"
          }
        ]

      },
      "vitals-hub": {
        "ClusterId": "alertingServiceCluster",
        "Match": {
          "Path": "/vitalsHub/{**catchAll}"
        },
        "Transforms": [
          {
            "PathPattern": "/vitalsHub/{**catchAll}"
          }
        ]
      },
      "patient-api": {
        "ClusterId": "patientDataApiCluster",
        "Match": {
          "Path": "/patient/{**catchAll}"
        },
        "Transforms": [
          {
            "PathPattern": "api/patients/{**catchAll}"
          }
        ]
      },
      "history": {
        "ClusterId": "patientHistoryServiceCluster",
        "Match": {
          "Path": "/history/{patientId}"
        },
        "Transforms": [
          {
            "PathPattern": "/history/{patientId}"
          }
        ]
      },
      "chat-service": {
        "ClusterId": "chatServiceCluster",
        "Match": {
          "Path": "/chat/{**catchAll}"
        },
        "Transforms": [
          {
            "PathPattern": "/chat/{**catchAll}"
          }
        ]
      }
    },
    "Clusters": {
      "patientDataApiCluster": {
        "Destinations": {
          "patientDataApi": {
            "Address": "http://patientdataapi"
          }
        }
      },
      "alertingServiceCluster": {
        "Destinations": {
          "alertingService": {
            "Address": "http://alertingservice"
          }
        }
      },
      "patientMonitoringServiceCluster": {
        "Destinations": {
          "service1": {
            "Address": "http://patientmonitoringservice"
          }
        }
      },
      "patientHistoryServiceCluster": {
        "Destinations": {
          "service1": {
            "Address": "http://patienthistoryservice"
          }
        }
      },
      "chatServiceCluster": {
        "Destinations": {
          "chatService": {
            "Address": "http://chatservice"
          }
        }
      }

    }
  }
}
